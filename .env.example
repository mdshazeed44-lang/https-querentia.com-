# Ceipal ATS API — copy to .env.local and fill in real values.
# Generated in Ceipal: Admin setup > API Settings > API Access Configuration.
# These are SERVER-ONLY (no NEXT_PUBLIC_ prefix) so they never reach the browser bundle.
CEIPAL_AUTH_URL=https://api.ceipal.com/v2/createAuthtoken/
CEIPAL_EMAIL=you@example.com
CEIPAL_PASSWORD=your-api-password
CEIPAL_API_KEY=your-64-char-api-key

# ── LinkedIn auto-posting (Ceipal job -> LinkedIn company page) ──────────────
# Master switch. Nothing is ever posted unless this is exactly "true".
SOCIAL_AUTOPOST_ENABLED=false
# How many roles may go out per cron run. Keep it low: flooding a company page
# hurts reach. 2 per run x 2 runs/day = ~4 posts/day.
SOCIAL_MAX_POSTS_PER_RUN=2

# Upload-Post (holds the LinkedIn Marketing API partnership on our behalf).
# Dashboard: https://app.upload-post.com
UPLOAD_POST_API_KEY=your-upload-post-api-key
UPLOAD_POST_USER=your-upload-post-profile-name
# Company page URN from GET /api/uploadposts/linkedin/pages
# (e.g. urn:li:organization:12345678). Omit to post to the personal profile.
LINKEDIN_PAGE_ID=urn:li:organization:00000000

# Durable "already posted" store. REQUIRED — without it the cron refuses to run,
# because in-memory state would re-post every open role after a deploy.
# Upstash Redis or Vercel KV (KV_REST_API_URL / KV_REST_API_TOKEN also work).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Shared secret Vercel Cron sends as "Authorization: Bearer <value>".
CRON_SECRET=generate-a-long-random-string
